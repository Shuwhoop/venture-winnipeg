# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose in browser code.
SUPABASE_SECRET_KEY=

# Licensed MapLibre-compatible map style URL.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional Google Places UI Kit integration.
NEXT_PUBLIC_ENABLE_GOOGLE_PLACES_UI_KIT=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Comma-separated Venture administrator email addresses.
VENTURE_ADMIN_EMAILS=

# Application URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Newsletter and transactional email.
RESEND_API_KEY=
NEWSLETTER_TOKEN_SECRET=
VENTURE_EMAIL_FROM=Venture by Boogie Bangers <onboarding@resend.dev>
VENTURE_EMAIL_REPLY_TO=venturebangers@gmail.com

# Outside-beta feedback and anonymous journey analytics.
NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=true

