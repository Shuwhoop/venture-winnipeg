# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Licensed MapLibre-compatible style URL, for example from MapTiler.
NEXT_PUBLIC_MAP_STYLE_URL=

# Email delivery. Add only after verifying a Venture-owned domain.
RESEND_API_KEY=
VENTURE_FROM_EMAIL=Venture <weekend@yourdomain.ca>

# Optional Google Places UI Kit feature flag.
NEXT_PUBLIC_ENABLE_GOOGLE_PLACES_UI_KIT=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
